{
  "name": "playwright-bdd-automation",
  "version": "1.0.0",
  "description": "Enterprise-ready Playwright + TypeScript + Cucumber BDD framework featuring REST API testing, storageState session persistence, WCAG 2.1 AA accessibility auditing, network fault injection, hybrid UI+API workflows, and Reporting Labs interactive reports.",
  "private": true,
  "scripts": {
    "bddgen": "bddgen",
    "test": "bddgen && playwright test --project=chromium",
    "test:all-browsers": "bddgen && playwright test",
    "test:smoke": "bddgen && playwright test --project=chromium --grep \"@smoke\"",
    "test:api": "bddgen && playwright test --project=chromium --grep \"@api\"",
    "test:session": "bddgen && playwright test --project=chromium --grep \"@session\"",
    "test:a11y": "bddgen && playwright test --project=chromium --grep \"@a11y\"",
    "test:mock": "bddgen && playwright test --project=chromium --grep \"@mock\"",
    "test:hybrid": "bddgen && playwright test --project=chromium --grep \"@hybrid\"",
    "test:visual": "bddgen && playwright test --project=chromium --grep \"@visual\"",
    "test:saucedemo": "bddgen && playwright test --project=chromium --grep \"@saucedemo\"",
    "test:automationexercise": "bddgen && playwright test --project=chromium --grep \"@automationexercise\"",
    "test:demoqa": "bddgen && playwright test --project=chromium --grep \"@demoqa\"",
    "test:headed": "bddgen && playwright test --project=chromium --headed",
    "test:ui": "bddgen && playwright test --ui",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"const fs=require('fs');['.features-gen','reports','test-results','.auth'].forEach(d=>fs.rmSync(d,{recursive:true,force:true}));\""
  },
  "keywords": [
    "playwright",
    "playwright-bdd",
    "cucumber",
    "bdd",
    "pom",
    "typescript",
    "api-testing",
    "accessibility",
    "a11y",
    "faker",
    "reporting-labs",
    "test-automation",
    "qa-portfolio"
  ],
  "license": "MIT",
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@faker-js/faker": "^9.4.0",
    "@playwright/test": "^1.50.1",
    "@types/node": "^22.10.0",
    "dotenv": "^16.4.7",
    "playwright-bdd": "^8.2.0",
    "reporting-labs": "latest",
    "typescript": "^5.7.3"
  }
}
